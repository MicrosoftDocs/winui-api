{
  "build": {
    "content": [
      {
        "files": ["breadcrumb/toc.yml"]
      },
      {
        "files": [
          "**/*.md",
          "**/*.yml"
        ],
        "exclude": [
          "**/obj/**",
          "**/includes/**",
          "**/_themes/**",
          "api/overwrites/**",
          "README.md",
          "LICENSE",
          "LICENSE-CODE",
          "ThirdPartyNotices"
        ]
      }
    ],
    "resource": [
      {
        "files": [
          "**/*.png",
          "**/*.jpg",
          "**/*.svg",
          "**/*.gif",
          "**/*.bmp"
        ],
        "exclude": [
          "**/obj/**",
          "**/includes/**"
        ]
      }
    ],
    "overwrite": {
      "files": [
        "api/overwrites/**/*.md"
      ]
    },
    "globalMetadata": {
      "ROBOTS": "INDEX, FOLLOW",
      "apiPlatform": "dotnet",
      "breadcrumb_path": "~/breadcrumb/toc.yml",
      "feedback_system": "Standard",
      "feedback_product_url": "https://github.com/microsoft/microsoft-ui-xaml/issues/new/choose",
      "feedback_help_link_url": "https://learn.microsoft.com/answers/tags/105/windows-uwp/",
      "feedback_help_link_type": "get-help-at-qna",
      "uhfHeaderId": "MSDocsHeader-WinDevCenter",
      "titleSuffix": "WinUI",
      "defaultDevLang": "csharp",
      "author": "Karl-Bridge-Microsoft",
      "ms.author": "kbridge",
      "extendBreadcrumb": true,
      "hideEdit": "true",
      "ms.service": "windows-app-sdk",
      "ms.subservice": "winui-reference",
      "ms.topic": "reference",
      "ms.date": "03/01/2021",
      "keywords": "windows 10, uwp, winrt, api, winui, Windows UI Library",
      "searchScope": ["WinUI"],
      "api_location": ["microsoft.ui.xaml.dll"]  
    },
    "fileMetadata": {
      "langs": {
        "winui-api-build/**.yml": ["csharp", "vb", "fsharp","cppcx","cppwinrt","cpp"]
      },
      "feedback_product_url": 
      {
        "microsoft.ui*.yml": "https://github.com/microsoft/microsoft-ui-xaml/issues/new/choose" 
      },
      "author":
      {
        "microsoft.ui*": "jwmsft",
        "microsoft.ui.xaml.automation.peers*": "Karl-Bridge-Microsoft"
      },
      "ms.author":
      {
        "microsoft.ui*": "jimwalk",
        "microsoft.ui.xaml.automation.peers*": "kbridge"
      }		 		 
    },
    "template": [],
    "dest": "_site",
    "lruSize": 0
  }
}
